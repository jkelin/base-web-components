{
  "name": "webcomponents-workspace",
  "private": true,
  "workspaces": [
    "packages/*",
    "smoke",
    "microfw"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "check": "bun run typecheck",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck",
    "dev": "bun run --filter smoke dev",
    "lint": "bun run --parallel --filter '*' lint",
    "format": "bun run --parallel --filter '*' format",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0"
  },
  "packageManager": "bun@1.4.0"
}
