{
  "name": "@webcomponents/solid-counter",
  "version": "1.0.0",
  "description": "A compound SolidJS counter custom element.",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./src/index.ts",
    "./src/counter.ts",
    "./src/counter-buttons.tsx",
    "./src/counter-label.tsx",
    "./src/accordion.tsx",
    "./src/modal.tsx",
    "./src/popover.tsx",
    "./src/toggle-checkbox.tsx",
    "./src/otp-field.tsx",
    "./src/tabs.tsx",
    "./dist/solid-counter.js"
  ],
  "main": "./dist/solid-counter.js",
  "module": "./dist/solid-counter.js",
  "exports": {
    ".": {
      "import": "./dist/solid-counter.js",
      "default": "./dist/solid-counter.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests",
    "format": "oxfmt --write src tests"
  },
  "dependencies": {
    "solid-element": "^1.9.2",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "happy-dom": "^20.12.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.10"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
