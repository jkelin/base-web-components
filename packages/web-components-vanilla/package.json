{
  "name": "@webcomponents/vanilla-counter",
  "version": "1.0.0",
  "description": "A standalone vanilla JavaScript counter custom element.",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./src/index.ts",
    "./src/counter.ts",
    "./src/counter-buttons.ts",
    "./src/counter-label.ts",
    "./src/components.ts",
    "./src/accordion.ts",
    "./src/modal.ts",
    "./src/popover.ts",
    "./src/toggle-checkbox.ts",
    "./src/otp-field.ts",
    "./src/tabs.ts",
    "./dist/vanilla-counter.js"
  ],
  "main": "./dist/vanilla-counter.js",
  "module": "./dist/vanilla-counter.js",
  "exports": {
    ".": {
      "import": "./dist/vanilla-counter.js",
      "default": "./dist/vanilla-counter.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests",
    "format": "oxfmt --write src tests"
  },
  "devDependencies": {
    "happy-dom": "^20.12.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
