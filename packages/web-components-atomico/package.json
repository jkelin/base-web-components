{
  "name": "@webcomponents/atomico-counter",
  "version": "1.0.0",
  "description": "A standalone Atomico compound counter.",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./src/index.ts",
    "./src/counter.tsx",
    "./src/counter-minus-button.tsx",
    "./src/counter-label.tsx",
    "./src/counter-plus-button.tsx",
    "./src/components.tsx",
    "./dist/atomico-counter.js"
  ],
  "main": "./dist/atomico-counter.js",
  "module": "./dist/atomico-counter.js",
  "exports": {
    ".": {
      "import": "./dist/atomico-counter.js",
      "default": "./dist/atomico-counter.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests",
    "format": "oxfmt --write src tests"
  },
  "dependencies": {
    "atomico": "^2.2.0"
  },
  "devDependencies": {
    "happy-dom": "^20.12.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
