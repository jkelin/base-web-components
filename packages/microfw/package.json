{
  "name": "microfw",
  "version": "1.0.0",
  "private": true,
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/main.ts",
      "source": "./src/main.ts",
      "development": "./src/main.ts",
      "import": "./dist/microfw.js",
      "default": "./dist/microfw.js"
    }
  },
  "scripts": {
    "dev": "vite --config vite.showcase.config.ts",
    "preview": "vite preview --config vite.showcase.config.ts",
    "build": "vite build",
    "build:showcase": "vite build --config vite.showcase.config.ts",
    "size": "bun run build && bun -e \"const bytes=await Bun.file('dist/microfw.js').bytes();console.log(bytes.length,'raw /',Bun.gzipSync(bytes,{level:9}).length,'gzip-9')\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "format": "oxfmt --write src"
  },
  "dependencies": {
    "alien-signals": "^3.2.1"
  },
  "devDependencies": {
    "happy-dom": "^20.12.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  }
}
